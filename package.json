{
  "name": "skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "npm run generate:skills && next dev",
    "build": "npm run generate:skills && next build",
    "deploy": "npm run generate:skills && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "npm run generate:skills && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "db:local": "wrangler d1 migrations apply skills --local",
    "db:remote": "wrangler d1 migrations apply skills --remote",
    "upload": "node scripts/upload.mjs",
    "cf-typegen": "wrangler types",
    "types": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "gate": "npm run generate:skills && npm run types && npm test && npm run build",
    "generate:skills": "node scripts/generate-public-skills.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "better-auth": "^1.7.12",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
