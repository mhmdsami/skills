{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skills",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "skills.sam1.space", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skills",
      "database_id": "972ed26d-ffdd-41db-9b83-54061423b807",
      "migrations_dir": "migrations/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "skills"
    }
  ],
  "observability": { "enabled": true },
  "vars": {
    "BETTER_AUTH_URL": "https://skills.sam1.space"
  }
}
